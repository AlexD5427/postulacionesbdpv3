# ---------------------------------------------------------------------------
# Plataforma de Talento BDP S.A.M. - variables de entorno
# ---------------------------------------------------------------------------
# La app funciona 100% sin configurar nada (modo demo con datos semilla).
# Cuando se conecte la base de datos real, definir estas variables en Vercel.

# URL publica del sitio (usada por metadata / Open Graph)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Fuente de datos: "seed" (JSON interno) | "http" (API externa) | "postgres"
DATA_SOURCE="seed"

# Si DATA_SOURCE=http
CONVOCATORIAS_API_URL=""
CONVOCATORIAS_API_TOKEN=""

# Si DATA_SOURCE=postgres (Neon / Supabase / RDS)
DATABASE_URL=""

# Correo saliente para alertas de convocatorias (opcional)
SMTP_URL=""
ALERTAS_FROM="talento@bdp.com.bo"
